# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nokay?schema=public"

# Authentication (to be selected and configured in the next phase)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Stripe — never expose secret keys to the browser
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email provider
RESEND_API_KEY=""
EMAIL_FROM="NOKAY <contact@example.com>"

# Private object storage (credentials are server-side only)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
